          {
            "accessAssertion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "examples": ["Overseer API"]
                }
              }
            },
            "headers": {
              "X-Overseer-Request-Id": {
                "description": "Application request correlation ID for support, logs, and traces.",
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^request_[A-Z0-9]{26}$",
                  "example": "request_01KZGWMQ4054AXZGW9RR1VJ3JM"
                }
              }
            }
          },
          "401": {
            "description": "AccessUnauthorized",
            "content": {
              "application/json": {
