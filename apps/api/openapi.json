        "parameters": [],
        "security": [
          {
            "accessAssertion": []
          }
        ],
        "responses": {
          "201": {
            "description": "Workspace state after the requested operation completes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^workspace_[\\s\\S]*?$",
                      "description": "Stable Workspace identity returned by the create Workspace operation.",
                      "examples": ["workspace_01KZGWRATYFXD8QCG7QTKG5C3S"]
                    },
                    "name": {
                      "type": "string",
                      "allOf": [
                        {
                          "minLength": 1
                        },
                        {
                          "maxLength": 200
                        },
                        {
                          "pattern": "\\S"
                        },
                        {
                          "pattern": "^[^\\p{Cc}\\p{Zl}\\p{Zp}]*$",
                          "description": "Human-readable Workspace display name.",
                          "examples": ["Product Engineering"]
                        }
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": ["active", "archived"]
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "name", "state", "createdAt", "updatedAt"],
                  "additionalProperties": false,
                  "description": "Workspace state after the requested operation completes.",
                  "examples": [
                    {
                      "id": "workspace_01KZGWRATYFXD8QCG7QTKG5C3S",
                      "name": "Product Engineering",
                      "state": "active",
                      "createdAt": "2026-08-08T14:34:41.913Z",
                      "updatedAt": "2026-08-08T14:34:41.913Z"
                    }
                  ]
                },
