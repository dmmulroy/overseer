{
  "name": "overseer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:alchemy-local": "bun test ./tests/alchemy-local/gateway-local.bun.ts",
    "test:browser": "vp test run tests/browser",
    "test:workerd": "vp test run tests/http tests/workerd",
    "check": "vp check && vp run typecheck && vp test run && vp run test:alchemy-local && vp build && vp run check:reminder",
    "check:reminder": "node scripts/check-reminder.mjs",
    "deploy": "npm run build && alchemy deploy",
    "dev": "ACCESS_AUDIENCE=local-development OVERSEER_ALLOWED_ORIGIN=http://localhost:1337 OVERSEER_AUTHENTICATION_MODE=local-human alchemy dev",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@effect/atom-react": "4.0.0-beta.101",
    "@effect/platform-browser": "4.0.0-beta.101",
    "@effect/sql-sqlite-do": "4.0.0-beta.101",
    "@noble/hashes": "2.2.0",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.101",
    "jose": "6.2.4",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scheduler": "0.27.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@effect/platform-bun": "4.0.0-beta.101",
    "@effect/platform-node": "4.0.0-beta.101",
    "@oxlint/plugins": "1.73.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "alchemy": "2.0.0-beta.64",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "miniflare": "4.20260722.0",
    "playwright": "1.62.0",
    "shadcn": "4.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6",
    "workerd": "1.20260729.1"
  },
  "overrides": {
    "@effect/atom-react": "4.0.0-beta.101",
    "@effect/platform-browser": "4.0.0-beta.101",
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/platform-node-shared": "4.0.0-beta.101",
    "@effect/sql-sqlite-do": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "workerd": "$workerd"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
