{
  "name": "overseer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm test:unit",
    "plan:production": "vp run @overseer/api#plan:production",
    "deploy:production": "vp run @overseer/api#deploy:production",
    "deploy:api": "vp run @overseer/api#deploy:production",
    "deploy:shared-infrastructure": "vp run @overseer/shared-infrastructure#deploy:production",
    "destroy:production:api": "vp run @overseer/api#destroy:production",
    "destroy:production:shared-infrastructure": "vp run @overseer/shared-infrastructure#destroy:production",
    "plan:shared-infrastructure": "vp run @overseer/shared-infrastructure#plan:production",
    "ready": "vp run check",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "vp run --no-cache @overseer/api#test:e2e:deployed",
    "test:e2e:deployed": "vp run --no-cache @overseer/api#test:e2e:deployed",
    "test:e2e:local": "vp run --no-cache @overseer/api#test:e2e:local",
    "test:unit": "vp test run tools/oxlint && vp run @overseer/api#test:unit"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "26.3.0",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.80.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
