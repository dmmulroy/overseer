{
  "name": "overseer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm test:unit",
    "ready": "vp run check",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "vp run --no-cache @overseer/api#test:e2e",
    "test:unit": "vp test run tools/oxlint && vp run @overseer/api#test:unit"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.107",
    "@oxlint/plugins": "1.78.0",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-beta.107",
    "oxlint": "1.78.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
