{
  "name": "overseer",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check && vp run -r test",
    "ready": "vp run check"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "alchemy": "2.0.0-beta.67",
    "effect": "4.0.0-beta.102",
    "vite-plus": "0.2.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
